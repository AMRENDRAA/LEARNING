int main(){

  








// To know that the number is Prime or not     

int number ;
cin>>number;
int n=number;

int flag=0;

for(int i=n-1;i>1;i--){
    if(n%i==0){
        flag=1;
        break;

    }
}


if(flag==1){
    cout<<"Not Prime"<<endl;
}else{
    cout<<"Prime"<<endl;
}



}
