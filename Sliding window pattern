1. Max Sum Subarray of size K

class Solution {
  public:
    int maxSubarraySum(vector<int>& arr, int k) {
        // code here
        int windowsum=0;
        int n=arr.size();
        for(int i=0;i<k;i++){
            windowsum+=arr[i];
        }
        int maxsum=windowsum;
        for(int i=k;i<n;i++){
            windowsum=windowsum-arr[i-k]+arr[i];
            maxsum=max(maxsum,windowsum);
            
        }
        
        return maxsum;
    }
};


