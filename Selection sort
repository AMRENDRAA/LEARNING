class Solution {
public:
    vector<int> sortArray(vector<int>& nums) {

 //SELECTION SORT 

 for(int i=0;i<nums.size();i++){

     // Traverse each position
    for(int j=i+1;j<nums.size();j++){

     // Compare with all later elements

        if(nums[j]<nums[i]){

             // Swap elements
             swap(nums[j], nums[i]);
        }
    }
 }


        return nums;

    




    }




};
