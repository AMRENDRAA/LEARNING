class Solution {
public:
    int numOfSubarrays(vector<int>& arr, int k, int threshold) {



        int left=0;
        long long int sum=0;


        for(int i=0;i<k;i++){
            sum+=arr[i];
        }

         long long avg=sum/k;
         int c=0;

         if(avg>=threshold){
            c++;
         }
        //  int left=0;


        for(int i=k;i<arr.size();i++){

            sum=sum-arr[left++];
            sum=sum+arr[i];

            int avg=sum/k;

            if(avg>=threshold){
                c++;
            }
         


        }


        return c;
        
    }
};

