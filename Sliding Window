Subarray Problem 


 Maximum Average Subarray I

class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {

  double sum = 0;

        // First window
        for(int i = 0; i < k; i++){
            sum += nums[i];
        }

        double maxSum = sum;

        int left = 0;

        // Sliding window
        for(int i = k; i < nums.size(); i++){

            sum -= nums[left++];
            sum += nums[i];

            maxSum = max(maxSum, sum);
        }

        return maxSum / k;
}
};


