class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {


        //TLE 

               double maxi = INT_MIN;

        for(int i=0;i<=nums.size()-k;i++){
            double sum=0;
    

            for(int j=i;j<k+i;j++){
                sum=sum+nums[j];


            }

            sum=sum/k;
            if(sum>maxi){
                maxi=sum;

            }







        }

        return maxi;
        
        
    }
};
